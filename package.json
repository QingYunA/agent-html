{
  "name": "agent-html",
  "version": "1.0.0",
  "description": "Zero-dependency, single-file HTML design system & agent skill for LLMs inspired by shadcn/ui",
  "type": "module",
  "bin": {
    "agent-html": "./bin/cli.mjs"
  },
  "scripts": {
    "validate": "node skills/agent-html/scripts/validate.mjs --all",
    "test:rules": "node scripts/test-rules.mjs",
    "test:smoke": "node skills/agent-html/scripts/smoke.mjs && node skills/agent-html/scripts/smoke.mjs --selftest",
    "test": "npm run validate && node scripts/test-rules.mjs",
    "test:all": "npm test && npm run test:smoke",
    "eval": "node scripts/run-evals.mjs",
    "eval:score": "node scripts/run-evals.mjs --score-only"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "agent-skill",
    "skills",
    "claude-code",
    "pi",
    "codex",
    "cursor",
    "shadcn",
    "zero-dependency",
    "single-file-html",
    "dashboard",
    "report"
  ],
  "author": "QingYunA",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QingYunA/agent-html.git"
  },
  "bugs": {
    "url": "https://github.com/QingYunA/agent-html/issues"
  },
  "homepage": "https://github.com/QingYunA/agent-html#readme"
}
